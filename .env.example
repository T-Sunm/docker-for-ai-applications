# Shared artifact directory; mount the model-artifacts volume here in containers
MODEL_DIR=/models

# API container runtime configuration
INFERENCE_DEVICE=cpu
MOCK_MODE=0
HF_HUB_OFFLINE=1
DEFAULT_OCR_MODEL=rapidocr
MAX_OCR_LINES=20
MAX_UPLOAD_MB=10

# Preparation container only; leave empty for public model repositories
HF_TOKEN=

# Streamlit frontend when run locally; Compose sets http://backend:8000
BACKEND_URL=http://127.0.0.1:8000
